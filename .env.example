# Copy this file to .env and add your API key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
CAREER_AI_MODEL=grok-4.7

# Email verification and password reset use authenticated SMTP (no XAMPP sendmail setup required).
# Set these values for an SMTP provider that permits username/password SMTP AUTH.
APP_BASE_URL=http://localhost/CareerRoadmap
MAIL_FROM_ADDRESS=your-smtp-account@example.com
MAIL_FROM_NAME=CareerRoadmap
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=tls
MAIL_SMTP_USERNAME=your-smtp-account@example.com
MAIL_SMTP_PASSWORD=your-16-character-app-password

# Outlook.com recipients can receive these emails. Outlook.com as the SENDER requires OAuth2;
# the simple SMTP AUTH method above is for providers that explicitly support it (for example Gmail app passwords).
